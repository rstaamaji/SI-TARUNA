{
  "info": {
    "_postman_id": "si-taruna-rbac-module06",
    "name": "SI-TARUNA - Module 06 RBAC Authorization",
    "description": "Koleksi Postman untuk pengujian Role Based Access Control (RBAC) SI-TARUNA (Karang Taruna Setya Bakti).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth - Login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.success && res.data && res.data.token) {",
              "    pm.collectionVariables.set('adminToken', res.data.token);",
              "    pm.test('Login Admin Berhasil', () => {",
              "        pm.expect(pm.response.code).to.eql(200);",
              "        pm.expect(res.data.user.role).to.eql('ADMIN');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login sebagai ADMIN. Token otomatis disimpan ke variabel {{adminToken}}."
      }
    },
    {
      "name": "2. Auth - Login MEMBER",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.success && res.data && res.data.token) {",
              "    pm.collectionVariables.set('memberToken', res.data.token);",
              "    pm.test('Login Member Berhasil', () => {",
              "        pm.expect(pm.response.code).to.eql(200);",
              "        pm.expect(res.data.user.role).to.eql('MEMBER');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"member\",\n  \"password\": \"member123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Login sebagai MEMBER. Token otomatis disimpan ke variabel {{memberToken}}."
      }
    },
    {
      "name": "3. Admin - Akses Fitur Manajemen (Harus 200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin Berhasil Akses Endpoint Manajemen', () => {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.true;",
              "    pm.expect(res.data.adminUser.role).to.eql('ADMIN');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/management-data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "management-data"]
        },
        "description": "Endpoint khusus ADMIN. Diproteksi oleh requireAdmin. Menghasilkan 200 OK."
      }
    },
    {
      "name": "4. Member - Coba Akses Endpoint Admin (Harus 403 Forbidden)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Member Ditolak Mengakses Endpoint Admin (HTTP 403 Forbidden)', () => {",
              "    pm.expect(pm.response.code).to.eql(403);",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.false;",
              "    pm.expect(res.message).to.include('403 Forbidden');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/management-data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "management-data"]
        },
        "description": "Uji pembobolan: Member mencoba mengakses endpoint Admin. Backend wajib menolak dengan HTTP 403 Forbidden."
      }
    },
    {
      "name": "5. Member - Akses Endpoint Data Anggota (Harus 200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Member Berhasil Akses Data Khusus Anggota', () => {",
              "    pm.expect(pm.response.code).to.eql(200);",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/member/view-data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "member", "view-data"]
        },
        "description": "Endpoint khusus Anggota. Diproteksi oleh requireMember. Menghasilkan 200 OK."
      }
    },
    {
      "name": "6. Guest - Tanpa Token ke Endpoint Admin (Harus 401 Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Request Tanpa Token Ditolak (HTTP 401 Unauthorized)', () => {",
              "    pm.expect(pm.response.code).to.eql(401);",
              "    const res = pm.response.json();",
              "    pm.expect(res.success).to.be.false;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/management-data",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "management-data"]
        },
        "description": "Request tanpa menyertakan Authorization Bearer header. Menghasilkan HTTP 401 Unauthorized."
      }
    }
  ]
}
