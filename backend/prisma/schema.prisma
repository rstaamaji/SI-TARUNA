// Prisma Schema for SI-TARUNA
// Karang Taruna Setya Bakti - Tuk Uluh, Sringin, Jumantono

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ArisanStatus {
  PENDING
  WON
  PAID
}

enum EventType {
  MEETING
  COMMUNITY_SERVICE
  SOCIAL
  SPORTS
  OTHER
}

enum NotificationType {
  INFO
  EVENT
  FINANCE
  ANNOUNCEMENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member              Member?
  financeTransactions FinanceTransaction[] @relation("CreatedFinance")
  cashWithdrawals     CashWithdrawal[]     @relation("CreatedWithdrawal")
  announcements       Announcement[]       @relation("CreatedAnnouncement")
  meetingMinutes      MeetingMinute[]      @relation("CreatedMeetingMinute")
  notifications       Notification[]

  @@map("users")
}

model Member {
  id           String       @id @default(uuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberNumber String       @unique
  name         String
  gender       Gender
  phone        String?
  address      String
  joinDate     DateTime     @default(now())
  status       MemberStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendances     Attendance[]
  cashWithdrawals CashWithdrawal[]
  arisans         Arisan[]

  @@map("members")
}

model FinanceTransaction {
  id              String          @id @default(uuid())
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String
  transactionDate DateTime        @default(now())
  createdById     String
  createdBy       User            @relation("CreatedFinance", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("finance_transactions")
}

model CashWithdrawal {
  id             String   @id @default(uuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount         Decimal  @db.Decimal(12, 2)
  withdrawalDate DateTime @default(now())
  purpose        String
  description    String?
  createdById    String
  createdBy      User     @relation("CreatedWithdrawal", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cash_withdrawals")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  location    String
  type        EventType @default(MEETING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendances Attendance[]

  @@map("events")
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([memberId, eventId])
  @@map("attendances")
}

model Announcement {
  id               String    @id @default(uuid())
  title            String
  content          String    @db.Text
  announcementDate DateTime  @default(now())
  eventDate        DateTime?
  createdById      String
  createdBy        User      @relation("CreatedAnnouncement", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("announcements")
}

model MeetingMinute {
  id          String   @id @default(uuid())
  meetingDate DateTime
  title       String
  content     String   @db.Text
  createdById String
  createdBy   User     @relation("CreatedMeetingMinute", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("meeting_minutes")
}

model Arisan {
  id        String       @id @default(uuid())
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  drawDate  DateTime?
  status    ArisanStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("arisans")
}

model JimpitanGroup {
  id          String   @id @default(uuid())
  groupNumber Int      @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records JimpitanRecord[]

  @@map("jimpitan_groups")
}

model JimpitanRecord {
  id        String        @id @default(uuid())
  groupId   String
  group     JimpitanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  amount    Decimal       @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("jimpitan_records")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}
