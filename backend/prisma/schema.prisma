// Prisma Schema for SI-TARUNA
// Karang Taruna Setya Bakti - Tuk Uluh, Sringin, Jumantono

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  MEMBER
}

enum Gender {
  MALE
  FEMALE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ArisanStatus {
  PENDING
  UPCOMING
  WON
  PAID
}

enum EventType {
  MEETING
  COMMUNITY_SERVICE
  SOCIAL
  SPORTS
  ARISAN
  TARUNA
  OTHER
}

enum NotificationType {
  INFO
  EVENT
  FINANCE
  ANNOUNCEMENT
  KERJA_BAKTI
  RAPAT
  ARISAN
  ATTENTION
}

enum AnnouncementType {
  PENGUMUMAN
  RAPAT
  KERJA_BAKTI
  ARISAN
  INFORMASI
  LAINNYA
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role       Role      @default(MEMBER)
  isApproved Boolean   @default(true)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member              Member?
  financeTransactions FinanceTransaction[] @relation("CreatedFinance")
  cashWithdrawals     CashWithdrawal[]     @relation("CreatedWithdrawal")
  announcements       Announcement[]       @relation("CreatedAnnouncement")
  meetingMinutes      MeetingMinute[]      @relation("CreatedMeetingMinute")
  notifications       Notification[]

  @@map("users")
}

model Member {
  id           String       @id @default(uuid())
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  memberNumber String       @unique
  name         String
  gender       Gender
  phone        String?
  address      String
  joinDate     DateTime     @default(now())
  status       MemberStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendances     Attendance[]
  cashWithdrawals CashWithdrawal[]
  arisans         Arisan[]

  @@map("members")
}

model FinanceTransaction {
  id              String          @id @default(uuid())
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  description     String
  source          String?         @default("Lainnya")
  category        String?         @default("Lainnya")
  transactionDate DateTime        @default(now())
  createdById     String
  createdBy       User            @relation("CreatedFinance", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cashWithdrawal  CashWithdrawal? @relation("WithdrawalTransaction")

  @@map("finance_transactions")
}

model CashWithdrawal {
  id                    String    @id @default(uuid())
  withdrawerName        String    @default("Anggota") // Nama pengambil
  memberId              String?   // Opsional: link ke anggota jika pengambil adalah anggota terdaftar
  member                Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  amount                Decimal   @db.Decimal(12, 2)
  withdrawalDate        DateTime  @default(now())
  purpose               String    // Keperluan pengambilan kas
  description           String?   // Keterangan tambahan
  financeTransactionId  String?   @unique // Link ke FinanceTransaction EXPENSE (satu-satu, no double count)
  financeTransaction    FinanceTransaction? @relation("WithdrawalTransaction", fields: [financeTransactionId], references: [id], onDelete: SetNull)
  createdById           String
  createdBy             User      @relation("CreatedWithdrawal", fields: [createdById], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("cash_withdrawals")
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  dayOfWeek   String?
  time        String?
  location    String
  type        EventType @default(MEETING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendances Attendance[]

  @@map("events")
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([memberId, eventId])
  @@map("attendances")
}

model Announcement {
  id               String           @id @default(uuid())
  title            String
  content          String           @db.Text
  type             AnnouncementType @default(PENGUMUMAN)
  isAttention      Boolean          @default(false)
  announcementDate DateTime         @default(now())
  eventDate        DateTime?
  createdById      String
  createdBy        User             @relation("CreatedAnnouncement", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("announcements")
}

model MeetingMinute {
  id            String   @id @default(uuid())
  meetingDate   DateTime
  dayOfWeek     String?  // Hari pelaksanaan: Senin, Selasa, dll
  title         String   // Judul rapat
  location      String   @default("Balai Dusun Tuk Uluh") // Tempat pelaksanaan
  meetingLeader String   @default("Ketua Karang Taruna")  // Pimpinan rapat
  noteTaker     String   @default("Sekretaris")          // Notulis
  content       String   @db.Text                         // Isi notulensi
  conclusion    String?  @db.Text                         // Kesimpulan rapat
  followUp      String?  @db.Text                         // Tindak lanjut / rencana aksi
  createdById   String
  createdBy     User     @relation("CreatedMeetingMinute", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("meeting_minutes")
}

model Arisan {
  id        String       @id @default(uuid())
  memberId  String?
  member    Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  month     Int
  year      Int
  drawDate  DateTime?
  location  String?      @default("Balai Dusun Tuk Uluh")
  status    ArisanStatus @default(PENDING)
  notes     String?
  amount    Decimal?     @db.Decimal(12, 2) @default(500000)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("arisans")
}

model JimpitanGroup {
  id          String   @id @default(uuid())
  groupNumber Int      @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records JimpitanRecord[]

  @@map("jimpitan_groups")
}

model JimpitanRecord {
  id        String        @id @default(uuid())
  groupId   String
  group     JimpitanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  amount    Decimal       @db.Decimal(12, 2)
  notes     String?
  inputDate DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([groupId, month, year])
  @@map("jimpitan_records")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model OrganizationSetting {
  id          String   @id @default("default")
  orgName     String   @default("Karang Taruna Setya Bakti")
  logoUrl     String?  @default("/assets/logo.png")
  phone       String?  @default("0812-3456-7890")
  email       String?  @default("setyabakti.tukuluh@gmail.com")
  socialMedia String?  @default("@karangtaruna_setyabakti")
  address     String   @default("Dusun Tuk Uluh, Desa Sringin, Kec. Jumantono, Kab. Karanganyar, Jawa Tengah")
  hamlet      String?  @default("Tuk Uluh")
  village     String?  @default("Sringin")
  subDistrict String?  @default("Jumantono")
  district    String?  @default("Karanganyar")
  period      String   @default("2024 - 2027")
  description String?  @default("Wadah pembinaan dan pengembangan generasi muda Dusun Tuk Uluh, Desa Sringin, Kecamatan Jumantono.")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("organization_settings")
}
