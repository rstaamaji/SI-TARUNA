# ==============================================================================
# SI-TARUNA Backend Production Environment Configuration Template
# Salin file ini menjadi .env pada server hosting/VPS produksi Anda:
# cp .env.production.example .env
# ==============================================================================

# Mode Operasional (Wajib diisi 'production')
NODE_ENV=production

# Port Server Backend API
PORT=5000

# URL Domain Frontend Produksi (Digunakan untuk CORS & Socket.IO handshake)
# Dukung multi-domain dengan pemisah koma tanpa spasi
CLIENT_URL="https://taruna-springin.id"
ALLOWED_ORIGINS="https://taruna-springin.id,https://admin.taruna-springin.id"

# Koneksi Database PostgreSQL Produksi
# Catatan: Tambahkan parameter connection pool & SSL jika diperlukan di cloud DB (e.g. ?sslmode=require&connection_limit=20)
DATABASE_URL="postgresql://user_taruna:StrongPasswordHere123@prod-db.example.com:5432/si_taruna_prod?schema=public&sslmode=prefer"

# Kunci Rahasia JSON Web Token (JWT)
# PENTING: Gunakan string acak berkekuatan tinggi minimal 32 karakter (e.g. openssl rand -base64 32)
JWT_SECRET="ganti_dengan_kunci_acak_sangat_rahasia_dan_panjang_minimal_32_karakter"
JWT_EXPIRES_IN="7d"
